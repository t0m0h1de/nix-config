  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); case \"$cmd\" in *find*-exec*) jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"find の -exec/-execdir は使用禁止です。別コマンドを実行する場合は `find ... | xargs ...` を使ってください。\"}}' ;; esac"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if printf '%s' \"$cmd\" | grep -Eq '(^|[^[:alnum:]_])cd[[:space:]]' && printf '%s' \"$cmd\" | grep -q '>'; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"cd と出力リダイレクトの同居は禁止です(Claude Code の組み込みガードで承認が必要になります)。cd を使わず絶対パスでコマンドを書いてください。\"}}'; fi"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); stripped=$(printf '%s' \"$cmd\" | sed -e \"s/'[^']*'//g\" -e 's/\"[^\"]*\"//g'); if printf '%s' \"$stripped\" | grep -Eq '(^|[;&|][[:space:]]*)(for|while|until|if|case)[[:space:]]' || printf '%s' \"$stripped\" | grep -Eq '(^|[;&|[:space:]])\\('; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"サブシェル( )や for/while/until/if/case の複合構文は権限判定が分解できず承認プロンプトになります。&& ; | と xargs による平坦なコマンドに書き換えてください(例: for f in a b; do cmd $f; done → printf \\\"%s\\\\n\\\" a b | xargs -n1 cmd)。\"}}'; fi"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); stripped=$(printf '%s' \"$cmd\" | sed -e \"s/'[^']*'//g\" -e 's/\"[^\"]*\"//g'); if printf '%s' \"$stripped\" | grep -Eq '(^|[;&|][[:space:]]*)[A-Za-z_][A-Za-z0-9_]*=[^[:space:];&|]*[[:space:]]+[^[:space:]]'; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"FOO=bar cmd 形式(envプレフィックス付きコマンド)は権限判定を通らず承認プロンプトになります。行を分けて代入する(VAR=value 改行 cmd)か、値を直接引数に書いてください。代入単体や VAR=v; cmd は問題ありません。\"}}'; fi"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); stripped=$(printf '%s' \"$cmd\" | sed -e \"s/'[^']*'//g\" -e 's/\"[^\"]*\"//g'); if printf '%s' \"$stripped\" | grep -Eq '(^|[;&|][[:space:]]*)(kubectl|gcloud|bq|gsutil)[[:space:]]+-' && ! printf '%s' \"$stripped\" | grep -Eq '(^|[;&|][[:space:]]*)(kubectl|gcloud|bq|gsutil)[[:space:]]+--(version|help)([[:space:]]|$)'; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"kubectl/gcloud/bq/gsutil のグローバルフラグ(-n, --context, --project など)をサブコマンドの前に置かないでください。許可ルールは前方一致なので Bash(kubectl get:*) 等にマッチせず毎回承認が必要になります。フラグはサブコマンドの後ろへ(例: kubectl -n stg get pods → kubectl get pods -n stg / gcloud --project=p compute instances list → gcloud compute instances list --project=p)。\"}}'; fi"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); stripped=$(printf '%s' \"$cmd\" | sed -e \"s/'[^']*'//g\" -e 's/\"[^\"]*\"//g'); if printf '%s' \"$stripped\" | grep -Eq '(^|[;&|[:space:]])gh[[:space:]]+api[[:space:]]' && printf '%s' \"$stripped\" | grep -Eq '(-X|--method)[[:space:]]+(POST|PATCH|PUT|DELETE)|[[:space:]](-f|--field|--raw-field|--input)[[:space:]]'; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"ask\",permissionDecisionReason:\"gh api の書き込み操作(-X POST/PATCH/PUT/DELETE または -f/--field/--input)です。読み取りの gh api は許可済みですが、書き込みは内容を確認してください。\"}}'; fi"
          }
        ]
      }
    ]
  }
